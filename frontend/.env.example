# Frontend environment variables (Vite)
# Copy this file to frontend/.env if you need to override the API URL.
# Docker Compose also references frontend/.env via env_file.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Backend API base URL used by frontend/src/api/chatApi.js
# Default if unset: http://localhost:3001
VITE_API_URL=http://localhost:3001
