# Backend environment variables
# Copy this file to backend/.env and fill in the values.
# Docker Compose loads backend/.env via env_file.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Groq API key (https://console.groq.com)
# Used by the Groq client (backend/src/config/groq.js), the LangGraph agent
# (backend/src/agents/mainAgent.js), and the self-critique pass
# (backend/src/services/selfCritiqueService.js).
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# HTTP port for the Express server (backend/server.js). Default: 3001
PORT=3001

# ChromaDB HTTP URL (backend/src/services/ragService.js).
# Hybrid local mode default: http://localhost:8000
# Docker Compose already sets CHROMA_URL=http://chromadb:8000 on the backend service.
CHROMA_URL=http://localhost:8000

# Agent LLM model used by the LangGraph ReAct agent
# (backend/src/agents/mainAgent.js). Default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# Self-critique LLM model (backend/src/services/selfCritiqueService.js).
# Default: llama-3.1-8b-instant
GROQ_CRITIQUE_MODEL=llama-3.1-8b-instant

# If "true", delete and re-ingest the Chroma collection on startup
# (backend/src/services/ragService.js). Default: unset/false
RESET_CHROMA_DB=false

# Debug logging for the RAG pipeline (backend/src/services/ragService.js).
# Set to "true" to enable. Default: unset/false
DEBUG_RAG=false

# Debug logging for dictionary query expansion
# (backend/src/services/queryExpander.js). Set to "true" to enable. Default: unset/false
DEBUG_QUERY_EXPANDER=false

# -----------------------------------------------------------------------------
# Optional: Langfuse observability
# -----------------------------------------------------------------------------
# Used by the Langfuse CallbackHandler in backend/src/services/agentService.js.
# Leave blank unless you are sending traces to a Langfuse project.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
